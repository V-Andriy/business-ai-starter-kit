# Business AI Starter Kit private workspace ignore rules

# Local kit source cache
.business-ai-kit/source/
.business-ai-kit/backups/
.business-ai-kit/tmp/

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Local credentials and service configs
credentials.json
client_secret*.json
service-account*.json
firebase-adminsdk*.json
google-credentials*.json
aws-credentials*
.aws/
.azure/
.gcloud/
.config/gcloud/

# Logs and runtime output
*.log
logs/
tmp/
temp/
.tmp/
.cache/
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Node and web apps
node_modules/
.next/
dist/
build/
coverage/
.turbo/
.vercel/

# Editor and local tool state
.vscode/
.idea/
*.swp
*.swo

# Large/private data by default
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
exports/
private-exports/

# Keep safe examples
!.env.example
!**/.env.example
